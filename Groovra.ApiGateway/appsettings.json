{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "billing-webhook-route": {
        "ClusterId": "billing-cluster",
        "RateLimiterPolicy": "IpBasedLimiter",
        "Match": {
          "Path": "/billing/webhook/{**catch-all}"
        },
        "Order": 0
      },
      "billing-route": {
        "ClusterId": "billing-cluster",
        "RateLimiterPolicy": "IpBasedLimiter",
        "Match": {
          "Path": "/billing/{**catch-all}"
        },
        "Order": 1,
        "AuthorizationPolicy": "Default"
      },
      "auth-users-search-route": {
        "ClusterId": "auth-cluster",
        "RateLimiterPolicy": "IpBasedLimiter",
        "Match": {
          "Path": "/auth/users/search",
          "Methods": [ "GET" ]
        },
        "Order": -2,
        "AuthorizationPolicy": "Default"
      },
      "auth-users-admin-route": {
        "ClusterId": "auth-cluster",
        "RateLimiterPolicy": "IpBasedLimiter",
        "Match": {
          "Path": "/auth/users/{**catch-all}"
        },
        "Order": -1,
        "AuthorizationPolicy": "AdminOnly"
      },
      "auth-route": {
        "ClusterId": "auth-cluster",
        "RateLimiterPolicy": "IpBasedLimiter",
        "Match": {
          "Path": "/auth/{**catch-all}"
        }
      },
      "profile-route": {
        "ClusterId": "auth-cluster",
        "RateLimiterPolicy": "IpBasedLimiter",
        "Match": {
          "Path": "/profile/{**catch-all}"
        },
        "AuthorizationPolicy": "Default"
      },
      "artist-route": {
        "ClusterId": "auth-cluster",
        "RateLimiterPolicy": "IpBasedLimiter",
        "Match": {
          "Path": "/artist/{**catch-all}"
        },
        "AuthorizationPolicy": "Default"
      },
      "media-route": {
        "ClusterId": "auth-cluster",
        "RateLimiterPolicy": "IpBasedLimiter",
        "Match": {
          "Path": "/media/{**catch-all}"
        }
      },
      "media-upload-route": {
        "ClusterId": "chat-cluster",
        "RateLimiterPolicy": "IpBasedLimiter",
        "Match": {
          "Path": "/api/media/{**catch-all}"
        },
        "Order": 1,
        "AuthorizationPolicy": "Default"
      },
      "music-static-files": {
        "ClusterId": "music-cluster",
        "RateLimiterPolicy": "IpBasedLimiter",
        "Match": {
          "Path": "/music/files/{**catch-all}"
        },
        "Order": 0
      },
      "music-jamendo": {
        "ClusterId": "music-cluster",
        "RateLimiterPolicy": "IpBasedLimiter",
        "Match": {
          "Path": "/music/jamendo/{**catch-all}"
        },
        "Order": 1,
        "AuthorizationPolicy": "AdminOnly"
      },
      "music-tracks-play-route": {
        "ClusterId": "music-cluster",
        "RateLimiterPolicy": "IpBasedLimiter",
        "Match": {
          "Path": "/music/tracks/{id}/play",
          "Methods": [ "POST" ]
        },
        "Order": 1,
        "AuthorizationPolicy": "Default"
      },
      "music-tracks-comments-write": {
        "ClusterId": "music-cluster",
        "RateLimiterPolicy": "IpBasedLimiter",
        "Match": {
          "Path": "/music/tracks/{trackId}/comments",
          "Methods": [ "POST" ]
        },
        "Order": 1,
        "AuthorizationPolicy": "Default"
      },
      "music-tracks-comments-actions": {
        "ClusterId": "music-cluster",
        "RateLimiterPolicy": "IpBasedLimiter",
        "Match": {
          "Path": "/music/tracks/comments/{**catch-all}",
          "Methods": [ "POST", "DELETE" ]
        },
        "Order": 1,
        "AuthorizationPolicy": "Default"
      },
      "music-stats-global-route": {
        "ClusterId": "music-cluster",
        "RateLimiterPolicy": "IpBasedLimiter",
        "Match": {
          "Path": "/music/stats/global"
        },
        "Order": 1
      },
      "music-tracks-modify": {
        "ClusterId": "music-cluster",
        "RateLimiterPolicy": "IpBasedLimiter",
        "Match": {
          "Path": "/music/tracks/{**catch-all}",
          "Methods": [
            "POST",
            "PUT",
            "PATCH",
            "DELETE"
          ]
        },
        "Order": 2,
        "AuthorizationPolicy": "ArtistOnly"
      },
      "music-tracks-public-get": {
        "ClusterId": "music-cluster",
        "RateLimiterPolicy": "IpBasedLimiter",
        "Match": {
          "Path": "/music/tracks/{**catch-all}",
          "Methods": [ "GET" ]
        },
        "Order": 2
      },
      "music-artists-public-get": {
        "ClusterId": "music-cluster",
        "RateLimiterPolicy": "IpBasedLimiter",
        "Match": {
          "Path": "/music/artists/{**catch-all}",
          "Methods": [ "GET" ]
        },
        "Order": 2
      },
      "music-upload-modify": {
        "ClusterId": "music-cluster",
        "RateLimiterPolicy": "IpBasedLimiter",
        "Match": {
          "Path": "/music/Upload/{**catch-all}",
          "Methods": [
            "POST",
            "PUT",
            "PATCH",
            "DELETE"
          ]
        },
        "Order": 2,
        "AuthorizationPolicy": "ArtistOnly"
      },
      "music-albums-modify": {
        "ClusterId": "music-cluster",
        "RateLimiterPolicy": "IpBasedLimiter",
        "Match": {
          "Path": "/music/albums/{**catch-all}",
          "Methods": [
            "POST",
            "PUT",
            "PATCH",
            "DELETE"
          ]
        },
        "Order": 2,
        "AuthorizationPolicy": "ArtistOnly"
      },
      "music-albums-public-get": {
        "ClusterId": "music-cluster",
        "RateLimiterPolicy": "IpBasedLimiter",
        "Match": {
          "Path": "/music/albums/{**catch-all}",
          "Methods": [ "GET" ]
        },
        "Order": 2
      },
      "music-favorites-route": {
        "ClusterId": "music-cluster",
        "RateLimiterPolicy": "IpBasedLimiter",
        "Match": {
          "Path": "/music/favorites/{**catch-all}"
        },
        "Order": 2,
        "AuthorizationPolicy": "Default"
      },
      "music-ai-mixes-public-get": {
        "ClusterId": "music-cluster",
        "RateLimiterPolicy": "IpBasedLimiter",
        "Match": {
          "Path": "/music/playlists/ai-mixes",
          "Methods": [ "GET" ]
        },
        "Order": 1
      },
      "music-playlists-search-public-get": {
        "ClusterId": "music-cluster",
        "RateLimiterPolicy": "IpBasedLimiter",
        "Match": {
          "Path": "/music/playlists/search",
          "Methods": [ "GET" ]
        },
        "Order": 1
      },
      "music-playlists-route": {
        "ClusterId": "music-cluster",
        "RateLimiterPolicy": "IpBasedLimiter",
        "Match": {
          "Path": "/music/playlists/{**catch-all}"
        },
        "Order": 2,
        "AuthorizationPolicy": "Default"
      },
      "history-route": {
        "ClusterId": "history-cluster",
        "RateLimiterPolicy": "IpBasedLimiter",
        "Match": {
          "Path": "/api/history/{**catch-all}"
        },
        "Order": 2,
        "AuthorizationPolicy": "Default"
      },
      "music-route": {
        "ClusterId": "music-cluster",
        "RateLimiterPolicy": "IpBasedLimiter",
        "Match": {
          "Path": "/music/{**catch-all}"
        },
        "Order": 3,
        "AuthorizationPolicy": "Default"
      },
      "auth-openapi-route": {
        "ClusterId": "auth-cluster",
        "RateLimiterPolicy": "IpBasedLimiter",
        "Match": {
          "Path": "/docs/auth/openapi.json"
        },
        "Transforms": [
          {
            "PathPattern": "/openapi/v1.json"
          }
        ]
      },
      "music-openapi-route": {
        "ClusterId": "music-cluster",
        "RateLimiterPolicy": "IpBasedLimiter",
        "Match": {
          "Path": "/docs/music/openapi.json"
        },
        "Transforms": [
          {
            "PathPattern": "/openapi/v1.json"
          }
        ]
      },
      "history-openapi-route": {
        "ClusterId": "history-cluster",
        "RateLimiterPolicy": "IpBasedLimiter",
        "Match": {
          "Path": "/docs/history/openapi.json"
        },
        "Transforms": [
          {
            "PathPattern": "/openapi/v1.json"
          }
        ]
      },
      "billing-openapi-route": {
        "ClusterId": "billing-cluster",
        "RateLimiterPolicy": "IpBasedLimiter",
        "Match": {
          "Path": "/docs/billing/openapi.json"
        },
        "Transforms": [
          {
            "PathPattern": "/openapi/v1.json"
          }
        ]
      },
      "chat-openapi-route": {
        "ClusterId": "chat-cluster",
        "RateLimiterPolicy": "IpBasedLimiter",
        "Match": {
          "Path": "/docs/chat/openapi.json"
        },
        "Transforms": [
          {
            "PathPattern": "/openapi/v1.json"
          }
        ]
      },
      "chat-hub-route": {
        "ClusterId": "chat-cluster",
        "RateLimiterPolicy": "IpBasedLimiter",
        "Match": {
          "Path": "/chat/hub/{**catch-all}"
        },
        "Order": 0,
        "AuthorizationPolicy": "Default"
      },
      "chat-route": {
        "ClusterId": "chat-cluster",
        "RateLimiterPolicy": "IpBasedLimiter",
        "Match": {
          "Path": "/chat/{**catch-all}"
        },
        "Order": 1,
        "AuthorizationPolicy": "Default"
      }
    },
    "Clusters": {
      "billing-cluster": {
        "HttpClient": {
          "DangerousAcceptAnyServerCertificate": true
        },
        "Destinations": {
          "billing-destination": {
            "Address": "http://billing-service:8080"
          }
        }
      },
      "auth-cluster": {
        "HttpClient": {
          "DangerousAcceptAnyServerCertificate": true
        },
        "Destinations": {
          "auth-destination": {
            "Address": "http://auth-service:8080"
          }
        }
      },
      "music-cluster": {
        "HttpClient": {
          "DangerousAcceptAnyServerCertificate": true
        },
        "Destinations": {
          "music-destination": {
            "Address": "http://music-service:8080"
          }
        }
      },
      "history-cluster": {
        "HttpClient": {
          "DangerousAcceptAnyServerCertificate": true
        },
        "Destinations": {
          "history-destination": {
            "Address": "http://history-service:8080"
          }
        }
      },
      "chat-cluster": {
        "HttpClient": {
          "DangerousAcceptAnyServerCertificate": true
        },
        "Destinations": {
          "chat-destination": {
            "Address": "http://chat-service:8080"
          }
        }
      }
    }
  },
  "Jwt": {
    "Key": "",
    "Issuer": "groovra.local",
    "Audience": "groovra.clients"
  },
  "Redis": {
    "ConnectionString": ""
  }
}