# Groovra Backend — Azure Production Environment Variables

# Azure SQL Server / Database Connection String
DB_CONNECTION_STRING=Data Source=SQL1001.site4now.net;Initial Catalog=db_acbf9c_groovradb;User Id=db_acbf9c_groovradb_admin;Password=YOUR_DB_PASSWORD;Encrypt=True;TrustServerCertificate=True;

# JWT Authentication Secret Key (must be at least 32 characters)
JWT_SECRET_KEY=replace-with-a-random-secret-at-least-32-characters-long

# Allowed CORS Origins (comma-separated, supports *.vercel.app)
CORS_ALLOWED_ORIGINS=https://localhost:5178,http://localhost:5178,https://*.vercel.app,https://your-custom-domain.com

# Google OAuth 2.0 Credentials
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Email Service Config (SMTP or Mailtrap)
Email__Provider=Smtp
Email__SmtpHost=smtp.gmail.com
Email__SmtpPort=587
Email__SmtpUser=your-email@gmail.com
Email__SmtpPass=your-app-password
Email__FromEmail=noreply@groovra.com
Email__FromName=Groovra Music
